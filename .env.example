# Adobe IMS OAuth. `authorization_code` is for OAuth Web App credentials; `client_credentials`
# is for OAuth Server-to-Server credentials.
# ADOBE_AUTH_MODE=client_credentials
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# ADOBE_SCOPES=               # comma-separated, from your Developer Console project
# ADOBE_IMS_URL=https://ims-na1.adobelogin.com/ims/token/v3
# ADOBE_REDIRECT_URI=         # OAuth Web App redirect URI; required by `npm run adobe:login`
# ADOBE_REFRESH_TOKEN=        # saved locally by `npm run adobe:login` for authorization_code mode
# Verify with: npm run ims:check
#
# Live Adobe MCP endpoints. A token enables an upstream; leave unset to stay on the built-in simulation.
# ADOBE_IMS_TOKEN=            # shared bearer token (or per-upstream: ADOBE_CDP_TOKEN, ADOBE_AEM_TOKEN, ADOBE_CLOUD_MANAGER_TOKEN,
#                             #   ADOBE_MARKETO_MCP_TOKEN, ADOBE_WORKFRONT_MCP_TOKEN, ADOBE_MARKETING_AGENT_TOKEN,
#                             #   ADOBE_BRAND_INTELLIGENCE_TOKEN, ADOBE_GENSTUDIO_TOKEN, ADOBE_COWORKER_TOKEN)
# ADOBE_UPSTREAMS=cdp,aem     # optional allow-list
# ADOBE_API_KEY=              # sent as x-api-key
# ADOBE_ORG_ID=               # Adobe IMS organization ID; sent as x-gw-ims-org-id and reported as identity.imsOrg
# ADOBE_SANDBOX_NAME=         # trusted default/allowed sandbox; sent as x-sandbox-name (explicit caller values must match)
# Logging (stderr): LOG_LEVEL=silent|error|warn|info|debug|trace (default info); LOG_FORMAT=text|json; LOG_FILE=./logs/mcp.log; LOG_MAX_CHARS=800
# CX Enterprise Coworker login (default ON). The Adobe sign-in token is kept as the user's "coworker" connection and every coworker call acts as that user.
# USE_COWORKER_LOGIN=0 restores the original flow (identity-only sign-in; coworker via the technical account).
# ADOBE_COWORKER_SCOPES=offline_access   # extra scopes requested at sign-in (must be enabled on the sign-in client); offline_access gives a refresh token
# ADOBE_COWORKER_SERVICES=               # extra services to run through the coworker connection (coworker and cdp are always included)
# USE_COWORKER_LOGIN=1
# LOG_LEVEL=info
# ADOBE_AEM_URL=              # optional override for the AEM MCP endpoint (not an AEM author REST URL)
# ADOBE_MARKETO_MCP_URL=      # optional override for the Marketo MCP endpoint (not a Marketo REST API URL)
# ADOBE_<KEY>_HEADERS={"x-custom":"v"}   # extra headers per upstream
# ADOBE_TOOL_MAP=./tool-map.json         # re-route built-in tools to live tools, see README
# Optional separate S2S credentials use ADOBE_CRED_<NAME>_CLIENT_ID/CLIENT_SECRET/SCOPES/ORG_ID
# and are selected per upstream in ADOBE_AUTH_POLICY, e.g. marketo_mcp -> credential "marketo".
# EMAIL_LISTS_FILE=./data/email-lists.json   # where uploaded email lists are stored (per signed-in user)
# MARKETO_BASE_URL / MARKETO_CLIENT_ID / MARKETO_CLIENT_SECRET: when all three are set, the live `marketo_rest`
# (read-only Marketo REST tools plus lead CSV import, static-list creation and list-membership writes) is enabled. It uses these Marketo credentials in every auth flow
# (service or coworker/delegated) and never an Adobe IMS token.
# AEM_AUTHOR_URL / AEM_API_KEY are direct-product API settings; this server's other live integrations use the Adobe MCP endpoints above
# and do not consume those direct API variables.
#
# Remote HTTP + ngrok (`npm run start:tunnel`)
# Adobe sign-in for the ChatGPT/OAuth login (OAuth Web App credential; redirect = <PUBLIC_URL>/oauth/adobe/callback)
# ADOBE_SIGNIN_CLIENT_ID=
# ADOBE_SIGNIN_CLIENT_SECRET=
# ADOBE_SIGNIN_REDIRECT_URI=
# ADOBE_SIGNIN_SCOPES=openid,AdobeID,profile        # identity only; not used for Adobe product API calls
# ADOBE_CONNECTION_ADOBE_SCOPES=                   # required for delegated product connections; exact scopes from the Adobe Developer Console, include offline_access for refresh tokens
# ADOBE_CONNECTION_<NAME>_SCOPES=                  # per-connection override
# ADOBE_CONNECTION_SCOPES=                         # optional shared default for delegated product connections
# ADOBE_USER_TOKEN_UPSTREAMS=cdp,marketing_agent   # delegated calls use a separately authorized product connection
# OAUTH_ALLOWED_EMAILS=you@example.com:marketing_ops
# LOGIN_SECRET=               # required for POST /auth/login via the tunnel and to approve OAuth consent; auto-generated if unset
# MCP_API_KEY=                # long-lived bearer for Codex/scripts (>=24 chars); auto-generated if unset
# MCP_API_KEY_USER=morgan.ops # demo identity the API key acts as
# OAUTH_DEFAULT_USER=lee.leader               # preselected identity on the ChatGPT consent page
# OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,openai.com,localhost,127.0.0.1
# PUBLIC_URL=                 # optional fixed issuer URL, e.g. https://your-domain.ngrok-free.dev
# NGROK_DOMAIN=               # reserved/static ngrok domain; omit for a random URL
# PORT=3000

# Authentication modes per operation, separate credentials, connections (see AUTH.md)
# ADOBE_AUTH_POLICY=./auth-policy.json
# ADOBE_AUTH_MODE_<SERVICE>=delegated|service
# ADOBE_CRED_<NAME>_CLIENT_ID= / _CLIENT_SECRET= / _SCOPES= / _ORG_ID=     # additional S2S credentials
# ADOBE_CONNECTION_<NAME>_SCOPES=                                          # scopes requested by the connect flow
# ADOBE_CONNECT_REDIRECT_URI=                                              # default PUBLIC_URL/connect/callback
